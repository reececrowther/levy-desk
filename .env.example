# Copy to .env.local and fill in values

# Postgres connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/levy_desk"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# Email (SMTP) for magic links
# For development, use Mailtrap or Ethereal (https://ethereal.email)
EMAIL_FROM="Levy Desk <noreply@levydesk.local>"
EMAIL_SERVER="smtp://user:pass@smtp.ethereal.email:587"

# Optional: Resend API key (alternative to SMTP)
# RESEND_API_KEY=""
